---
import Layout from "../../layouts/Layout.astro";
import { ShareViewer } from "../../components/ShareViewer";

export function getStaticPaths() {
  // Static placeholder — actual share IDs are handled client-side
  return [{ params: { id: "preview" } }];
}

const { id } = Astro.params;
---

<Layout title={`Partage ${id} — Shotboard Studio`}>
  <ShareViewer client:load />
</Layout>
